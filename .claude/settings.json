{
  "permissions": {
    "allow": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git worktree*)",
      "Bash(git push origin main)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(gh pr create*)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(deno check*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)",
      "Bash(supabase db push*)",
      "Bash(supabase migration up*)",
      "Bash(supabase functions deploy*)",
      "Bash(supabase secrets*)",
      "Bash(vercel*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/skills/multi-session-guard/hooks/session-start.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/skills/multi-session-guard/hooks/precheck.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/skills/multi-session-guard/guard.sh heartbeat >/dev/null 2>&1" }
        ]
      }
    ]
  }
}